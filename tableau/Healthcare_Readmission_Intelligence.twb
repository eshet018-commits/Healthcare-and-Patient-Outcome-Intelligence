            <zone forceUpdate='true' h='2285' id='18' type-v2='text' w='98400' x='800' y='4642'>
              <formatted-text>
                <run fontcolor='#000000' fontsize='13'>Understanding patient and utilization characteristics associated with 30-day readmission risk</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
