      <aliases enabled='yes' />
      <column caption='High Risk Encounters' datatype='integer' name='[Calculation_0764206056398848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [risk_category] = &quot;High Risk&quot;&#13;&#10;OR [risk_category] = &quot;Very High Risk&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='High Risk %' datatype='real' name='[Calculation_0764206056566785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0764206056398848])' />
      </column>
      <column caption='Prior Utilization Group' datatype='string' name='[Calculation_0764206097383426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_prior_visits] = 0 THEN &quot;0&quot;&#13;&#10;ELSEIF [total_prior_visits] &lt;= 2 THEN &quot;1-2&quot;&#13;&#10;ELSEIF [total_prior_visits] &lt;= 5 THEN &quot;3-5&quot;&#13;&#10;ELSE &quot;6+&quot;&#13;&#10;END' />
      </column>
      <column caption='30-Day Readmission Rate' datatype='real' name='[Calculation_1184494235643904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([actual_readmitted_30])' />
      </column>
      <column caption='Average Predicted Risk' datatype='real' name='[Calculation_1184494237102081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([predicted_readmission_risk])' />
      </column>
